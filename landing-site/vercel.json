{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "https://INDIRIZZO-RAILWAY.up.railway.app/api/landing" },
    { "source": "/admin", "destination": "https://INDIRIZZO-RAILWAY.up.railway.app/api/admin/dashboard" },
    { "source": "/api/:path*", "destination": "https://INDIRIZZO-RAILWAY.up.railway.app/api/:path*" }
  ],
  "redirects": [
    { "source": "/login", "destination": "https://app.bancomanda.com/login", "permanent": false },
    { "source": "/accedi", "destination": "https://app.bancomanda.com/", "permanent": false }
  ]
}
